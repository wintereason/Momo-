{
  "name": "momo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "node scripts/copy-ort.mjs && node scripts/build-runtime.mjs && node scripts/desktop.mjs",
    "desktop:build": "node scripts/copy-ort.mjs && node scripts/build-runtime.mjs && vite build && electron .",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "smoke": "node scripts/build-runtime.mjs && node scripts/check-agent-live.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.2.4",
    "koffi": "^2.9.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.169.0",
    "uiohook-napi": "^1.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.0.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "^33.2.1",
    "sharp": "^0.33.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "main": "electron/main.cjs"
}
