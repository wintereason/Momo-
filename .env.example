# =====================================================================================
#  Momo configuration template  (FREE services only).
#  Copy this file to ".env" (already done for you) and fill in ONLY what you want.
#
#  - Lines starting with # are comments. Leave a key empty to leave that feature off.
#  - Write values WITHOUT quotes or spaces:   KEY=value
#  - NEVER share this file, commit it, or paste its contents into a chat. It is git-ignored on purpose.
#  - It is read only by Momo's desktop shell. The UI never sees the keys (Settings shows only a tick or a dash).
#  - The file is plain text on your disk: anyone who can open your user folder can read it.
#  - After editing, click "Re-read .env" in Settings -> Connections (no restart needed).
#
#  WHAT IS REQUIRED?  Nothing. Momo already works with no key at all (built-in phrases, speech on your own PC).
#  The AI brain (section 1) is the one optional extra most people will want, and every choice below is FREE.
# =====================================================================================


# ============================  1) AI BRAIN  (optional; pick ONE free provider)  ============================
# Lets Momo understand free-form requests and explain what it reads. Off = only the built-in phrases work.
#
# IMPORTANT ABOUT PRIVACY: free cloud tiers usually have the right to log your prompts, and some may use them to
# improve their products. Check the provider's terms. That is why Momo, by default, sends ONLY the words you
# said, and never what is on your screen. Ollama (option D) is the only choice that keeps everything on your PC.
#
# Free tiers have request limits that change over time; look at the provider's page for the current numbers.

# Turn the AI on or off:  true / false
MOMO_AI_ENABLED=false

# Which provider to use:  gemini | groq | openrouter | ollama
MOMO_AI_PROVIDER=gemini

# --- A) Google Gemini  (RECOMMENDED for students: free tier, no credit card) ---
# Get a key: https://aistudio.google.com/apikey   (sign in with a Google account, click "Create API key")
GEMINI_API_KEY=

# --- B) Groq  (free tier, very fast open models, no credit card) ---
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# --- C) OpenRouter  (access to several models; use only the ones whose name ends in ":free") ---
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- D) Ollama  (runs on YOUR PC: free, private, no key. Needs about 2-4 GB of free RAM and is slower) ---
# Install from https://ollama.com, then run in a terminal:   ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434

# Model names. A FAST model understands requests; a SMART model explains things. Leave EMPTY to use Momo's defaults.
# Free model names change, so copy a current one from the provider's page. Examples of the style:
#   gemini:     gemini-flash-lite-latest   (a rolling name: Google retires numbered versions)
#   groq:       llama-3.3-70b-versatile    (smart)     llama-3.1-8b-instant    (fast)
#   openrouter: a model ending in :free
#   ollama:     llama3.2
MOMO_AI_MODEL_FAST=
MOMO_AI_MODEL_SMART=

# Limits that keep you safely inside the free tier.
MOMO_AI_MAX_OUTPUT_TOKENS=800
# Momo stops asking the AI for the rest of the day after this many requests.
MOMO_AI_MAX_REQUESTS_PER_DAY=200

# May Momo send TEXT FROM YOUR SCREEN (window text, browser tab titles) to a CLOUD provider when you ask about it?
# Default false = never; the AI then only ever sees the words you said. Ollama is always local, so it is unaffected.
MOMO_AI_ALLOW_SCREEN_CONTEXT=false


# ============================  2) OPTIONAL: SPEECH DOWNLOAD  ============================
# Momo already hears you with Whisper running on your own PC, and speaks with your Windows voices. Free and private.
# Hugging Face token (free): only needed if huggingface.co rate-limits the one-time speech-model download.
# Get one: https://huggingface.co/settings/tokens  (a "read" token is enough)
HF_TOKEN=


# ============================  3) ART  (no keys needed)  ============================
# For the art phase (character images and 3D models) use the providers' free websites by hand; no API key is needed.
